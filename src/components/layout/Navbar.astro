---
import GlobalSearch from '../ui/GlobalSearch';
import InstallPwa from '../ui/InstallPwa';
import { getUrl } from '../../utils/url';
---

<header class="sticky top-0 z-40 w-full border-b border-[#262626] bg-black/80 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-6">
      <a href={getUrl("/")} class="flex items-center gap-2.5 group">
        <!-- Vercel-style geometric triangle logo -->
        <div class="w-6 h-6 rounded flex items-center justify-center bg-white text-black transition-transform group-hover:scale-105">
          <svg viewBox="0 0 75 65" height="13" width="15" fill="currentColor">
            <path d="M37.5 0L75 65H0z"></path>
          </svg>
        </div>
        <span class="font-sans font-semibold text-sm tracking-tight text-[#ededed] group-hover:text-white transition-colors">
          LeetCode 150 <span class="text-text-muted font-normal">Revision</span>
        </span>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-5 text-xs font-sans text-text-muted">
        <a href={getUrl("/#patterns")} class="hover:text-text-primary transition-colors">
          Patterns
        </a>
        <a href={getUrl("/#problems")} class="hover:text-text-primary transition-colors">
          Problem Catalog
        </a>
        <a href={getUrl("/problem/1")} class="hover:text-text-primary transition-colors">
          Visualizer Workspace
        </a>
      </nav>
    </div>

    <!-- Right Controls: Global Search Island & Social Links -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <GlobalSearch client:idle />
      <InstallPwa client:load />

      <a
        href="https://github.com/Deepansh05dk/dsa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="hidden sm:inline-flex p-2 text-text-muted hover:text-text-primary hover:bg-[#141414] rounded-md border border-transparent hover:border-[#262626] transition-all"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Dark Mode Indicator Pill -->
      <div class="hidden lg:flex items-center gap-1.5 px-2 py-1 rounded-full text-[11px] font-mono text-text-dim bg-[#0a0a0a] border border-[#222222]">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-emerald animate-pulse"></span>
        <span>Dark / Vercel</span>
      </div>
    </div>
  </div>
</header>
