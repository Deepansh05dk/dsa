---
import type { PatternMeta } from '../../types/problem';
import { getUrl } from '../../utils/url';

interface Props {
  pattern: PatternMeta;
}

const { pattern } = Astro.props;
---

<a
  href={getUrl(`/patterns/${pattern.slug}`)}
  class="group relative flex flex-col justify-between p-5 rounded-xl bg-[#0a0a0a] border border-[#262626] hover:border-[#444444] hover:bg-[#111111] transition-all duration-200"
>
  <div>
    <!-- Top Row: Category Title & Problem Count Badge -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-[#141414] border border-[#262626] flex items-center justify-center text-accent-cyan group-hover:border-accent-cyan/50 group-hover:scale-105 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-sans font-semibold text-sm text-text-primary group-hover:text-white transition-colors">
          {pattern.name}
        </h3>
      </div>

      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#141414] text-text-muted border border-[#262626] group-hover:border-[#383838] group-hover:text-text-primary transition-colors">
        {pattern.problemCount} {pattern.problemCount === 1 ? 'prob' : 'probs'}
      </span>
    </div>

    <!-- Description -->
    <p class="text-xs text-text-secondary leading-relaxed line-clamp-2 mb-4 font-sans">
      {pattern.description}
    </p>
  </div>

  <!-- Invariant Footer / Cue -->
  <div class="pt-3 border-t border-[#1a1a1a] flex items-center justify-between text-[11px] text-text-dim group-hover:text-text-muted transition-colors font-mono">
    <span class="truncate max-w-[200px]">{pattern.keyInvariant}</span>
    <span class="group-hover:translate-x-1 transition-transform text-text-muted">→</span>
  </div>
</a>
