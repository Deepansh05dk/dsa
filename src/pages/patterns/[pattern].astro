---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PATTERNS } from '../../data/patterns';
import { INITIAL_PROBLEMS } from '../../data/problems';
import type { PatternMeta, LeetCodeProblem } from '../../types/problem';
import { getUrl } from '../../utils/url';

export async function getStaticPaths() {
  return PATTERNS.map((pattern) => {
    const problems = INITIAL_PROBLEMS.filter((p) => p.pattern === pattern.slug);
    return {
      params: { pattern: pattern.slug },
      props: { pattern, problems },
    };
  });
}

interface Props {
  pattern: PatternMeta;
  problems: LeetCodeProblem[];
}

const { pattern, problems } = Astro.props;

const getDifficultyClass = (diff: string) => {
  switch (diff) {
    case 'Easy':
      return 'text-[#34d399] bg-[#062817] border-[#059669]/30';
    case 'Medium':
      return 'text-[#fbbf24] bg-[#2a1b04] border-[#d97706]/30';
    case 'Hard':
      return 'text-[#f87171] bg-[#2d060a] border-[#dc2626]/30';
    default:
      return 'text-text-muted bg-surface-subtle border-border-default';
  }
};
---

<BaseLayout
  title={`${pattern.name} Algorithmic Pattern | LeetCode 150 Revision`}
  description={pattern.description}
>
  <div class="w-full max-w-[1600px] mx-auto px-3 sm:px-5 lg:px-6 py-5 space-y-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-text-muted">
      <a href={getUrl("/")} class="hover:text-text-primary transition-colors">Dashboard</a>
      <span class="text-text-dim">/</span>
      <a href={getUrl("/#patterns")} class="hover:text-text-primary transition-colors">Patterns</a>
      <span class="text-text-dim">/</span>
      <span class="text-text-primary">{pattern.name}</span>
    </nav>

    <!-- Pattern Deep-Dive Header -->
    <header class="space-y-4 pb-4 border-b border-[#262626]">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-[#141414] border border-[#262626] text-accent-cyan">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h1 class="text-3xl font-bold tracking-tight text-white font-sans">{pattern.name}</h1>
            <p class="text-xs text-text-secondary mt-1 font-sans">{pattern.description}</p>
          </div>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs">
          <span class="px-3 py-1 rounded-full bg-[#111111] border border-[#262626] text-text-primary">
            {pattern.problemCount} Curated Problems
          </span>
        </div>
      </div>
    </header>

    <!-- Algorithmic Invariant & Recognition Cues -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Invariant Box -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#0a0a0a] border border-[#262626] space-y-2.5">
        <div class="flex items-center gap-2 text-accent-cyan text-xs font-mono font-semibold uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Core Algorithmic Invariant</span>
        </div>
        <p class="text-xs sm:text-sm text-text-primary leading-relaxed font-sans">
          {pattern.keyInvariant}
        </p>
      </div>

      <!-- Recognition Cues Box -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#0a0a0a] border border-[#262626] space-y-2.5">
        <div class="flex items-center gap-2 text-accent-emerald text-xs font-mono font-semibold uppercase tracking-wider">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Interview Recognition Cues</span>
        </div>
        <ul class="space-y-1.5 text-xs text-text-secondary list-disc list-inside font-sans">
          {pattern.recognitionCues.map((cue) => (
            <li class="leading-relaxed">{cue}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Problems in this Pattern -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#262626]">
        <h2 class="text-xl font-bold tracking-tight text-white font-sans">
          Pattern Problem Set
        </h2>
        <span class="text-xs font-mono text-text-dim">
          {problems.length} of {pattern.problemCount} Available
        </span>
      </div>

      {problems.length === 0 ? (
        <div class="p-10 rounded-xl bg-[#0a0a0a] border border-[#262626] text-center space-y-3">
          <p class="text-sm text-text-muted font-sans">
            Curated problems for <strong class="text-text-primary">{pattern.name}</strong> will be registered in Milestone 2.
          </p>
          <a
            href={getUrl("/")}
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-md text-xs font-medium bg-[#141414] hover:bg-[#1a1a1a] text-text-primary border border-[#262626] transition-colors"
          >
            ← Back to Revision Dashboard
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {problems.map((prob) => (
            <a
              href={getUrl(`/problem/${prob.id}`)}
              class="group p-5 rounded-xl bg-[#0a0a0a] border border-[#262626] hover:border-[#404040] hover:bg-[#111111] transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono text-xs text-text-dim">#{prob.id}</span>
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono border ${getDifficultyClass(prob.difficulty)}`}>
                    {prob.difficulty}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-text-primary group-hover:text-white transition-colors">
                  {prob.title}
                </h3>
                <p class="text-xs text-text-secondary line-clamp-2 leading-relaxed">
                  {prob.statement}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-[#1a1a1a] flex items-center justify-between text-xs font-mono text-text-dim">
                <span>Optimal: <span class="text-accent-cyan">{prob.optimal.complexity.time}</span></span>
                <span class="text-accent-emerald group-hover:translate-x-1 transition-transform">Launch Visualizer →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
