---
import Sidebar from '../components/layout/Sidebar';
import MobileNav from '../components/layout/MobileNav';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { getUrl } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  patternSlug?: string;
  problemId?: number;
}

const {
  title = 'LeetCode 150 Revision | Algorithmic Patterns & Step-by-Step Visualizer',
  description = 'Interactive revision platform for LeetCode Top Interview 150 problems organized by algorithmic patterns with interactive step-by-step visual solutions.',
  patternSlug,
  problemId,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getUrl("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />

    <!-- PWA Web App Manifest & Android / Mobile App Capabilities -->
    <link rel="manifest" href={getUrl("/manifest.webmanifest")} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="LeetCode 150" />
    <meta name="application-name" content="LeetCode 150" />
    <link rel="apple-touch-icon" href={getUrl("/icons/apple-touch-icon.png")} />

    <!-- SEO / Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Service Worker Registration for PWA Offline & Installability -->
    <script is:inline define:vars={{ swUrl: getUrl('/sw.js'), swScope: getUrl('/') }}>
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        // Clear any old buggy caches immediately
        if ('caches' in window) {
          caches.delete('lc150-pwa-v1').catch(() => {});
          caches.delete('lc150-pwa-v2').catch(() => {});
          caches.delete('lc150-pwa-v3').catch(() => {});
        }
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(swUrl, { scope: swScope })
            .then((reg) => {
              reg.update().catch(() => {});
            })
            .catch((err) => {
              console.debug('[PWA] SW register skipped:', err);
            });
        });
      }
    </script>
    <!-- Prevent Collapsed Sidebar Layout Shift -->
    <script is:inline>
      try {
        if (localStorage.getItem('lc150_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-[#050505] text-[#ededed] flex flex-col font-sans antialiased selection:bg-[#333333] selection:text-white">
    <!-- Ambient Radial Glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] pointer-events-none vercel-glow z-0"></div>

    <div class="flex-1 flex w-full relative z-10">
      <!-- Desktop Sidebar (Collapsible docked rail on lg screens) -->
      <div id="desktop-sidebar-container" class="hidden lg:block w-72 shrink-0 h-screen sticky top-0 z-30 transition-[width] duration-300 ease-in-out">
        <Sidebar client:load currentPatternSlug={patternSlug} currentProblemId={problemId} />
      </div>

      <!-- Main Content Container -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Mobile Navigation Header -->
        <MobileNav client:load currentPatternSlug={patternSlug} currentProblemId={problemId} />

        <!-- Desktop Top Header Navigation -->
        <Navbar />

        <!-- Page Content -->
        <main class="flex-1 w-full">
          <slot />
        </main>

        <!-- Footer -->
        <Footer />
      </div>
    </div>
  </body>
</html>
